{
  "name": "paybot-binance-vendas",
  "version": "1.0.0",
  "description": "Bot automatizado de vendas e assinaturas para WhatsApp e Telegram com cobrança via Binance Pay (USDT)",
  "main": "src/index.js",
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=8192 src/index.js",
    "start:nitro": "node --expose-gc --max-old-space-size=8192 src/index.js",
    "dev": "node --expose-gc --watch src/index.js",
    "test": "node test_suite.js"
  },
  "keywords": [
    "binance-pay",
    "whatsapp-bot",
    "telegram-bot",
    "subscriptions",
    "crypto-payments",
    "usdt",
    "baileys"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "link-preview-js": "^3.2.0",
    "pino": "^10.3.1",
    "puppeteer-core": "^25.16.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "rebrowser-puppeteer": "^25.16.0",
    "telegraf": "^4.16.3",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
