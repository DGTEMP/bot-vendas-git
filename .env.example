# Configurações do Servidor
PORT=3000
PUBLIC_URL=http://localhost:3000
TZ=America/Sao_Paulo

# Credenciais da API Oficial Binance Pay (Merchant)
# Obtenha em: https://merchant.binance.com/
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Modo de Simulação / Teste:
# Se 'true', permite testar o checkout e entrega imediata sem transferir USDT real
BINANCE_SIMULATION_MODE=true

# Credenciais do Bot do Telegram
# Crie o bot no Telegram em @BotFather para obter o Token
TELEGRAM_BOT_TOKEN=
# ID do Canal ou Grupo VIP do Telegram (ex: -1001234567890)
TELEGRAM_VIP_CHANNEL_ID=

# Ativar/Desativar Bots
WHATSAPP_ENABLED=true
TELEGRAM_ENABLED=true

# =========================================================================
# 🧠 CENTRAL MULTI-IA COM FAILOVER & MÚLTIPLAS CHAVES POR PROVEDOR
# =========================================================================
# Ordem de prioridade no fallback: se a 1ª IA der rate-limit (429) ou erro,
# o bot pula instantaneamente para a próxima da lista sem travar o cliente!
AI_FALLBACK_ORDER=gemini,groq,openai,deepseek,openrouter,local

# 1. Google Gemini (Texto, Visão OCR e Transcrição de Áudio nativa)
# Você pode cadastrar mais de uma chave separando por vírgula!
GEMINI_API_KEYS=chave_gemini_1,chave_gemini_2
GEMINI_API_KEY=

# 2. Groq (Meta Llama 3.3 70B & Whisper - Ultrarrápido e Gratuito)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEYS=gsk_chave_groq_1,gsk_chave_groq_2
GROQ_API_KEY=

# 3. OpenAI (ChatGPT GPT-4o-mini & Whisper)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEYS=sk_chave_openai_1,sk_chave_openai_2
OPENAI_API_KEY=

# 4. DeepSeek
# Obtenha em: https://platform.deepseek.com/
DEEPSEEK_API_KEYS=
DEEPSEEK_API_KEY=

# 5. OpenRouter
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEYS=
OPENROUTER_API_KEY=

# 6. IA Local / Ollama / Antigravity
ANTIGRAVITY_AI_ENDPOINT=http://localhost:20128/v1
ANTIGRAVITY_AI_KEY=sk-6dd285069ee60c6b-fcf00a-fe2a0f79
